[Unit]
Description=RPI Dashboard in Cage Wayland Kiosk
After=systemd-user-sessions.service systemd-logind.service
Wants=network-online.target
After=network-online.target
Conflicts=getty@tty1.service

[Service]
User=kiosk
Group=kiosk
PAMName=login
WorkingDirectory=/home/mucxep/Applications/rpi-dashboard
Environment=XDG_RUNTIME_DIR=/run/user/1001
Environment=WLR_LIBINPUT_NO_DEVICES=1

TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal

ExecStart=/usr/bin/cage -s -- /home/mucxep/Applications/rpi-dashboard/start.sh

Restart=always
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
